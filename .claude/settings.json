{
  "agent": "architect",
  "permissions": {
    "allow": [
      "Bash(codex exec:*)",
      "Bash(codex --version)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npm test)",
      "Bash(npm run validate:schedule)",
      "Bash(node --check:*)",
      "Bash(node --test:*)",
      "Bash(node scripts/validate-schedule.mjs)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git reset *)",
      "Bash(git stash *)",
      "Bash(git merge *)",
      "Bash(git branch -D *)",
      "Bash(git worktree remove *)",
      "Bash(git worktree prune *)",
      "Bash(gh pr *)",
      "Bash(taskkill *)",
      "Bash(node scripts/build-pages.mjs *)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git clean:*)",
      "Bash(wrangler:*)",
      "Bash(npx wrangler:*)",
      "Bash(gh release:*)"
    ]
  }
}
